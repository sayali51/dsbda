object WordCount {
  def main(args: Array[String]): Unit = {
    val sentence = "Apache Spark is fast. Spark is fun to use."

    val counts = sentence
      .split(" ")
      .map(_.toLowerCase.replaceAll("[.,!?]", ""))
      .groupBy(identity)
      .map { case (word, arr) => (word, arr.length) }
    
    counts.foreach { case (word, count) =>
      println(s"($word, $count)")
    }
  }
}

